# Copy this file to .env and fill in the keys you want to use.
# .env is gitignored — never commit real keys.

# --- Scene/motion prompt generation (choose one provider) -------------------
CLIPFORGE_LLM_PROVIDER=groq
# CLIPFORGE_LLM_KEY=
# Provider-specific env vars also work as a fallback if CLIPFORGE_LLM_KEY
# is unset (only one of these is needed, matching CLIPFORGE_LLM_PROVIDER):
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CLIPFORGE_LLM_MODEL=          # optional override, auto-selected per provider

# --- Script (narration) generation — separate from the above on purpose ----
# Defaults to Groq regardless of CLIPFORGE_LLM_PROVIDER above. To use Claude
# or GPT for scripts instead (via the same Replicate token below, no extra
# key needed), set:
# CLIPFORGE_SCRIPT_LLM_PROVIDER=replicate
# CLIPFORGE_SCRIPT_LLM_MODEL=anthropic/claude-4-sonnet

# --- AI visuals (image + image-to-video generation) ------------------------
# Get a key at https://replicate.com/account/api-tokens
# CLIPFORGE_REPLICATE_KEY=
# REPLICATE_API_TOKEN=          # also works as a fallback

# --- Channel character (optional — trained FLUX LoRA for a consistent host) --
# Train one via replicate.com/ostris/flux-dev-lora-trainer, then set both:
# CLIPFORGE_CHARACTER_LORA=your-owner/your-model:version-hash
# CLIPFORGE_CHARACTER_TRIGGER=your-trigger-word

# --- Optional ----------------------------------------------------------------
# CLIPFORGE_VOICE=en-US-AndrewMultilingualNeural
# CLIPFORGE_OUTPUT_DIR=./output
