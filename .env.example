# Copy this file to .env and fill in the keys you want to use.
# .env is gitignored — never commit real keys.

# --- Script generation (choose one provider) -------------------------------
CLIPFORGE_LLM_PROVIDER=groq
# CLIPFORGE_LLM_KEY=
# Provider-specific env vars also work as a fallback if CLIPFORGE_LLM_KEY
# is unset (only one of these is needed, matching CLIPFORGE_LLM_PROVIDER):
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CLIPFORGE_LLM_MODEL=          # optional override, auto-selected per provider

# --- AI visuals (image + image-to-video generation) ------------------------
# Get a key at https://replicate.com/account/api-tokens
# CLIPFORGE_REPLICATE_KEY=
# REPLICATE_API_TOKEN=          # also works as a fallback

# --- Optional ----------------------------------------------------------------
# CLIPFORGE_VOICE=en-US-AndrewMultilingualNeural
# CLIPFORGE_OUTPUT_DIR=./output
